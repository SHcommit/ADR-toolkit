{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CHECK policy exception",
  "type": "object",
  "required": ["id", "adr_id", "rule_id", "owner", "reason", "scope", "expiry", "created"],
  "properties": {
    "id": { "type": "string", "pattern": "^EXC-[0-9]{4}$" },
    "adr_id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
    "rule_id": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "expiry": { "type": "string", "format": "date" },
    "created": { "type": "string", "format": "date" }
  }
}
